---
interface TocItem {
	slug: string;
	text: string;
	children?: TocItem[];
}

interface Props {
	toc: TocItem[];
	depth?: number;
}

const { toc, depth = 0 } = Astro.props;
---

<ul>
	{
		toc.map((heading) => (
			<li>
				<a href={'#' + heading.slug}>
					<span>{heading.text}</span>
				</a>
				{Boolean(heading.children?.length) && (
					<Astro.self toc={heading.children ?? []} depth={depth + 1} />
				)}
			</li>
		))
	}
</ul>

<style define:vars={{ depth }}>
	@layer starlight.core {
		ul {
			list-style: none;
			margin: 0;
			padding: 0;
		}

		a {
			--pad-inline: 0.5rem;
			position: relative;
			display: block;
			padding-block: 0.32rem;
			padding-inline: calc(1rem * var(--depth) + var(--pad-inline) + 0.2rem) var(--pad-inline);
			border-radius: 0.25rem;
			color: #8a7c78;
			line-height: 1.35;
			text-decoration: none;
			overflow-wrap: anywhere;
			transition:
				background-color 180ms ease,
				color 180ms ease;
		}

		a:hover {
			background: rgba(120, 107, 103, 0.1);
			color: #5f5450;
			text-decoration: none;
		}

		a[aria-current='true'] {
			background: rgba(252, 80, 0, 0.06);
			color: var(--sl-color-text-accent);
		}

		a[aria-current='true']::before {
			content: '';
			position: absolute;
			inset-block: 0.35rem;
			inset-inline-start: -0.35rem;
			width: 2px;
			border-radius: 999px;
			background: var(--nice-header-bg, #fc5000);
		}

		:global(:root[data-theme='dark']) a {
			color: var(--sl-color-gray-3);
		}

		:global(:root[data-theme='dark']) a:hover {
			background: rgba(255, 255, 255, 0.07);
			color: var(--sl-color-white);
		}

		:global(:root[data-theme='dark']) a[aria-current='true'],
		:global(:root[data-theme='dark']) a[aria-current='true']:hover {
			color: var(--sl-color-text-accent);
		}
	}
</style>
