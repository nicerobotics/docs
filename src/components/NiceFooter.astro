---
import niceBoxLogo from '../assets/logos/nice-box.svg';
---

<footer class="nice-footer">
	<div class="nice-footer-brand">
		<img src={niceBoxLogo.src} alt="" width="34" height="34" loading="lazy" />
	</div>
	<div class="nice-footer-contact">
		<h2>联系我们</h2>
		<a href="mailto:contact@nicerobotics.hk">contact@nicerobotics.hk</a>
	</div>
	<p>Copyright © 2026 NICE Robotics Limited. All rights reserved.</p>
</footer>

<style>
	@layer starlight.core {
		.nice-footer {
			display: grid;
			grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
			align-items: start;
			gap: 1.25rem 2rem;
			box-sizing: border-box;
			width: 100vw;
			margin-block-start: 3.5rem;
			margin-inline: calc(50% - 50vw);
			padding-block: 1.5rem 0.75rem;
			padding-inline: max(1rem, calc((100vw - 82rem) / 2));
			border-block-start: 1px solid var(--sl-color-hairline);
			color: var(--sl-color-gray-3);
			font-size: var(--sl-text-sm);
		}

		.nice-footer-brand {
			display: flex;
			align-items: center;
			justify-self: start;
			gap: 0.75rem;
			min-width: 0;
		}

		.nice-footer-brand img {
			width: 2.125rem;
			height: 2.125rem;
			flex: 0 0 auto;
		}

		.nice-footer-contact {
			grid-column: 3;
			justify-self: end;
			text-align: end;
		}

		.nice-footer h2 {
			margin: 0 0 0.375rem;
			color: var(--sl-color-white);
			font-size: var(--sl-text-sm);
			font-weight: 650;
			line-height: 1.35;
		}

		.nice-footer a {
			color: var(--sl-color-gray-2);
			text-decoration: none;
		}

		.nice-footer a:hover {
			color: var(--sl-color-text-accent);
			text-decoration: none;
		}

		.nice-footer p {
			grid-column: 2;
			grid-row: 2;
			justify-self: center;
			margin: 0;
			text-align: center;
		}

		@media (max-width: 42rem) {
			.nice-footer {
				grid-template-columns: 1fr;
			}

			.nice-footer-brand,
			.nice-footer-contact,
			.nice-footer p {
				grid-column: 1;
				justify-self: center;
				text-align: center;
			}

			.nice-footer-contact {
				text-align: center;
			}
		}
	}
</style>
