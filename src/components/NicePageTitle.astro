---
import NiceIcon from './NiceIcon.astro';

const { title, icon } = Astro.locals.starlightRoute.entry.data;
const pageTitleId = '_top';
---

<h1 id={pageTitleId}>
	{icon && <NiceIcon class="nice-title-icon" name={icon} size="3rem" strokeWidth="1.6" />}
	<span>{title}</span>
</h1>

<style>
	@layer starlight.core {
		h1 {
			display: flex;
			align-items: center;
			gap: 0.65rem;
			margin-top: 1rem;
			font-size: clamp(1.95rem, 2.75vw, 2.5rem);
			line-height: var(--sl-line-height-headings);
			font-weight: 600;
			color: var(--sl-color-white);
		}

		.nice-title-icon {
			color: #9d7c72;
		}
	}
</style>
