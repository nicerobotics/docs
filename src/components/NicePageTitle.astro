---
const { title, emoji } = Astro.locals.starlightRoute.entry.data;
const pageTitleId = '_top';
---

<h1 id={pageTitleId}>
	{emoji && <span class="nice-title-emoji" aria-hidden="true">{emoji}</span>}
	<span>{title}</span>
</h1>

<style>
	@layer starlight.core {
		h1 {
			display: flex;
			align-items: center;
			gap: 0.5rem;
			margin-top: 1rem;
			font-size: var(--sl-text-h1);
			line-height: var(--sl-line-height-headings);
			font-weight: 600;
			color: var(--sl-color-white);
		}

		.nice-title-emoji {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 1.15em;
			height: 1.15em;
			font-size: 0.9em;
			line-height: 1;
		}
	}
</style>
