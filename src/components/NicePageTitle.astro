---
import NiceIcon from './NiceIcon.astro';

const { title, gitbookIcon } = Astro.locals.starlightRoute.entry.data;
const pageTitleId = '_top';
---

<h1 id={pageTitleId}>
	{gitbookIcon && <NiceIcon class="nice-title-icon" name={gitbookIcon} size="2.25rem" strokeWidth="1.75" />}
	<span>{title}</span>
</h1>

<style>
	@layer starlight.core {
		h1 {
			display: flex;
			align-items: center;
			gap: 0.5rem;
			margin-top: 1rem;
			font-size: var(--sl-text-h1);
			line-height: var(--sl-line-height-headings);
			font-weight: 600;
			color: var(--sl-color-white);
		}

		.nice-title-icon {
			color: #9d7c72;
		}
	}
</style>
