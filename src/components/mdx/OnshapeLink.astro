---
interface Props {
	href?: string;
	label?: string;
}

const { href, label = 'Onshape' } = Astro.props;
const icon =
	"size-[0.95rem] bg-current [mask:url('/assets/ui/lucide-globe.svg')_center/contain_no-repeat] [-webkit-mask:url('/assets/ui/lucide-globe.svg')_center/contain_no-repeat]";
---

{
	href ? (
		<a
			class="inline-flex size-6 items-center justify-center text-[#312f2e] no-underline transition-colors duration-200 hover:text-[#fc5000] [html[data-theme='dark']_&]:text-[#f3f1f0] [html[data-theme='dark']_&]:hover:text-[#ff7440]"
			href={href}
			target="_blank"
			rel="noreferrer"
			aria-label={label}
		>
			<span class={icon} aria-hidden="true" />
		</a>
	) : null
}
