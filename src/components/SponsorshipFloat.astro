---
import campaign from '../content/docs/_data/sponsorship.json';
import { localizedPath, splitPath } from '../i18n/locales';
const { locale } = splitPath(Astro.url.pathname);
const text = campaign.locales[locale];
---

<aside class="sponsorship-float fixed overflow-clip rounded-xl" data-sponsorship-float aria-label={text.title} data-pagefind-ignore>
  <details open class="relative">
    <summary class="sponsorship-toggle relative flex items-center justify-center" aria-label={text.toggle} title={text.toggle}>
      <span class="sponsorship-brand font-bold">{campaign.eyebrow}</span>
      <span class="sponsorship-compact font-semibold">{text.label}</span>
      <svg class="sponsorship-chevron absolute shrink-0" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m5 9 7 7 7-7" /></svg>
    </summary>
    <a class="sponsorship-link grid justify-items-center gap-4 text-center no-underline" href={localizedPath(campaign.path, locale)} aria-label={`${text.label} — ${text.title}`}>
      <img class="sponsorship-logo" src={campaign.logo} alt="" width="456" height="400" loading="eager" decoding="async" />
      <span class="sponsorship-copy block min-w-0 w-full text-center">
        <span class="sponsorship-title block font-bold">{text.title}</span>
        <span class="sponsorship-cta mt-3 inline-flex items-center justify-center gap-2 font-semibold">
          {text.label}
          <svg class="shrink-0" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 12h15M13 5l7 7-7 7" /></svg>
        </span>
      </span>
    </a>
  </details>
  <svg class="sponsorship-marquee pointer-events-none absolute inset-0 h-full w-full" fill="none" aria-hidden="true">
    <rect class="marquee-track" x="1.5" y="1.5" rx="11" pathLength="100" />
    <rect class="marquee-runner marquee-glow" x="1.5" y="1.5" rx="11" pathLength="100" />
    <rect class="marquee-runner" x="1.5" y="1.5" rx="11" pathLength="100" />
  </svg>
</aside>
<!-- Leave enough scroll room to lift the final content above the fixed entry. -->
<div class="sponsorship-reading-space" aria-hidden="true"></div>

<style>
  .sponsorship-float {
    right: max(1.25rem, env(safe-area-inset-right));
    bottom: max(1.25rem, env(safe-area-inset-bottom));
    z-index: 101;
    width: 14rem; max-width: calc(100vw - 2.5rem);
    background: #fff; color: #000;
    border: 0;
    box-shadow: 0 12px 36px rgb(0 0 0 / 20%), 0 3px 10px rgb(0 0 0 / 10%);
  }
  .sponsorship-marquee rect { width: calc(100% - 3px); height: calc(100% - 3px); }
  .marquee-track { stroke: #ffe2d1; stroke-width: 2; }
  .marquee-runner { stroke: #f9612b; stroke-width: 2.5; stroke-linecap: round; stroke-dasharray: 12 38; }
  .marquee-glow { stroke-width: 6; opacity: .18; }
  .sponsorship-marquee .marquee-runner { animation: sponsorship-circuit 5s linear infinite; }
  .sponsorship-toggle { padding: .7rem 1.7rem; min-height: 2.75rem; cursor: pointer; list-style: none; color: #000; text-align: center; }
  .sponsorship-toggle::-webkit-details-marker { display: none; }
  .sponsorship-toggle:hover { background: #fff4ee; }
  .sponsorship-brand { font-size: .65rem; letter-spacing: .1em; line-height: 1.4; color: #76513f; }
  .sponsorship-compact { font-size: .7rem; line-height: 1.4; white-space: nowrap; }
  .sponsorship-chevron { right: .6rem; top: calc(50% - 7px); }
  details[open] .sponsorship-compact, details:not([open]) .sponsorship-brand { display: none; }
  details:not([open]) .sponsorship-chevron { transform: rotate(180deg); }
  .sponsorship-link { grid-template-columns: minmax(0, 1fr); padding: .25rem 1rem 1.2rem; color: #000; }
  .sponsorship-logo { display: block; width: 6.5rem; max-width: 100%; height: auto; }
  .sponsorship-title { color: #000; font-size: 1.15rem; line-height: 1.35; text-wrap: balance; }
  .sponsorship-cta { max-width: 100%; color: #b83d09; background: #fff2e9; border-radius: .4rem; padding: .55rem .65rem; font-size: .8rem; line-height: 1.4; }
  .sponsorship-link:hover .sponsorship-cta { background: #ffe4d3; }
  .sponsorship-toggle:focus-visible, .sponsorship-link:focus-visible { outline: 2px solid #000; outline-offset: -4px; border-radius: .5rem; }
  .sponsorship-reading-space { height: 20rem; }
  @keyframes sponsorship-circuit { to { stroke-dashoffset: -100; } }
  @media (max-width: 50rem) {
    .sponsorship-float {
      right: max(.75rem, env(safe-area-inset-right));
      bottom: max(.75rem, env(safe-area-inset-bottom));
      width: 11.5rem; max-width: calc(100vw - 1.5rem);
    }
    .sponsorship-link { gap: .65rem; padding: .1rem .75rem .85rem; }
    .sponsorship-logo { width: 4.75rem; }
    .sponsorship-brand { font-size: .58rem; letter-spacing: .06em; }
    .sponsorship-title { font-size: .98rem; }
    .sponsorship-cta { font-size: .7rem; margin-block-start: .6rem; padding: .5rem .55rem; gap: .3rem; }
    .sponsorship-reading-space { height: 17rem; }
    :global(body[data-mobile-menu-expanded]) .sponsorship-float { visibility: hidden; }
  }
  @media (max-height: 420px) {
    .sponsorship-logo { width: 3rem; }
    .sponsorship-link { gap: .4rem; padding-bottom: .65rem; }
    .sponsorship-title { font-size: .9rem; }
    .sponsorship-cta { margin-block-start: .4rem; padding-block: .3rem; }
  }
  @media (prefers-reduced-motion: reduce) { .sponsorship-marquee .marquee-runner { animation: none; } }
  @media print { .sponsorship-float, .sponsorship-reading-space { display: none; } }
</style>
