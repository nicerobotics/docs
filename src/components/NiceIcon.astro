} as const;

type IconName = keyof typeof iconPaths;

interface Props {
	name?: IconName | string;
	size?: string;
	strokeWidth?: string | number;
	class?: string;
}

const { name = 'circle', size = '1em', strokeWidth = 2, class: className } = Astro.props;
const paths = iconPaths[name as IconName] ?? iconPaths.circle;
---

<svg
	class:list={['nice-icon', className]}
	aria-hidden="true"
	viewBox="0 0 24 24"
	width={size}
	height={size}
	fill="none"
	stroke="currentColor"
	stroke-width={strokeWidth}
	stroke-linecap="round"
	stroke-linejoin="round"
	focusable="false"
>
	{paths.map((d) => <path d={d} />)}
</svg>

<style>
	@layer starlight.core {
		.nice-icon {
			display: inline-block;
			flex-shrink: 0;
			vertical-align: -0.125em;
		}
	}
</style>
