	'screwdriver-wrench': ['M14.7 6.3 17 4l3 3-2.3 2.3', 'M4 20l7.2-7.2', 'M13 5l6 6', 'M5 5l4 4', 'M3.5 6.5 6.5 3.5'],
	futbol: ['M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20Z', 'M12 8l3 2.2-1.1 3.6H10l-1.1-3.6L12 8Z', 'M7 6l1.9 4.2', 'M17 6l-1.9 4.2', 'M6.5 17l3.5-3.2', 'M17.5 17l-3.6-3.2'],
