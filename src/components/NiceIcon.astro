---
import {
	BadgeCheck,
	Box,
	BrickWall,
	Car,
	Circle,
	CircleDot,
	CircleGauge,
	Cog,
	Cylinder,
	Disc3,
	Gem,
	Globe,
	Grid2x2,
	Hand,
	House,
	Lightbulb,
	Link,
	List,
	RotateCw,
	Truck,
	Wrench,
	type AstroComponent,
} from '@lucide/astro';

const iconComponents = {
	home: House,
	'hand-wave': Hand,
	gear: Cog,
	link: Link,
	gem: Gem,
	'screwdriver-wrench': Wrench,
	futbol: CircleDot,
	seal: BadgeCheck,
	'circle-0': CircleDot,
	'square-quarters': Grid2x2,
	chimney: BrickWall,
	car: Car,
	'truck-monster': CircleGauge,
	rotate: RotateCw,
	circle: Circle,
	'sushi-roll': Cylinder,
	list: List,
	bulb: Lightbulb,
	globe: Globe,
	box: Box,
	disc: Disc3,
	truck: Truck,
} satisfies Record<string, AstroComponent>;

type IconName = keyof typeof iconComponents;

interface Props {
	name?: IconName | string;
	size?: string;
	strokeWidth?: string | number;
	class?: string;
}

const { name = 'circle', size = '1em', strokeWidth = 2, class: className } = Astro.props;
const Icon = iconComponents[name as IconName] ?? Circle;
const classes = ['nice-icon', className].filter(Boolean).join(' ');
---

<Icon
	class={classes}
	aria-hidden="true"
	focusable="false"
	size={size}
	stroke-width={strokeWidth}
/>

<style>
	@layer starlight.core {
		.nice-icon {
			display: inline-block;
			flex-shrink: 0;
			vertical-align: -0.125em;
		}
	}
</style>
