	circle: ['M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20Z'],
	'sushi-roll': ['M5 7h10a4 4 0 0 1 0 10H5a4 4 0 0 1 0-10Z', 'M15 7a4 4 0 0 0 0 10', 'M6 10h3', 'M6 14h3'],
