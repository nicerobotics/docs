	chimney: ['M4 20V8h4V4h8v4h4v12', 'M4 12h16', 'M8 16h4', 'M16 16h4'],
	car: ['M5 16h14l-1.5-5.2A3 3 0 0 0 14.6 8H9.4a3 3 0 0 0-2.9 2.8L5 16Z', 'M4 16v3', 'M20 16v3', 'M7 19h.01', 'M17 19h.01'],
	'truck-monster': ['M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20Z', 'M12 18a6 6 0 1 0 0-12 6 6 0 0 0 0 12Z', 'M12 2v4', 'M12 18v4', 'M2 12h4', 'M18 12h4'],
