---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
  label: string;
  href: string;
  logo: string;
  pauseLabel: string;
  resumeLabel: string;
}
const { eyebrow, title, description, label, href, logo, pauseLabel, resumeLabel } = Astro.props;
---

<aside class="campaign-ribbon relative isolate my-6" data-campaign-banner data-motion="paused" aria-label={title}>
  <div class="ribbon-tail ribbon-tail-left" aria-hidden="true"></div>
  <div class="ribbon-tail ribbon-tail-right" aria-hidden="true"></div>
  <div class="ribbon-face relative overflow-hidden rounded-xl">
    <div class="ribbon-decoration pointer-events-none absolute inset-0" aria-hidden="true">
      <span class="ribbon-stripe ribbon-stripe-one"></span>
      <span class="ribbon-stripe ribbon-stripe-two"></span>
      <span class="ribbon-shine"></span>
    </div>
    <a class="campaign-link relative grid items-center no-underline" href={href} aria-label={`${label} — ${title}`}>
      <span class="campaign-logo grid place-items-center" aria-hidden="true">
        <img src={logo} alt="" width="456" height="400" loading="eager" decoding="async" />
      </span>
      <span class="campaign-copy block min-w-0">
        <span class="campaign-eyebrow block font-bold uppercase">{eyebrow}</span>
        <span class="campaign-title block font-bold">{title}</span>
        <span class="campaign-description block">{description}</span>
        <span class="campaign-cta inline-flex items-center justify-center gap-3 font-semibold">
          {label}
          <svg class="campaign-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 12h15M13 5l7 7-7 7" /></svg>
        </span>
      </span>
    </a>
    <button class="campaign-motion absolute grid place-items-center" type="button" data-campaign-motion data-pause-label={pauseLabel} data-resume-label={resumeLabel} aria-label={pauseLabel} title={pauseLabel} hidden>
      <svg class="motion-pause" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M4 3h3v10H4zm5 0h3v10H9z" /></svg>
      <svg class="motion-play" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="m5 3 8 5-8 5z" /></svg>
    </button>
  </div>
</aside>

<script>
  for (const banner of document.querySelectorAll<HTMLElement>('[data-campaign-banner]')) {
    const button = banner.querySelector<HTMLButtonElement>('[data-campaign-motion]');
    if (!button) continue;
    const preference = matchMedia('(prefers-reduced-motion: reduce)');
    let paused = false;
    try { paused = sessionStorage.getItem('nice-campaign-motion') === 'paused'; } catch { /* Optional preference only. */ }
    const update = () => {
      const running = !preference.matches && !paused;
      banner.dataset.motion = running ? 'running' : 'paused';
      button.hidden = preference.matches;
      button.setAttribute('aria-label', (running ? button.dataset.pauseLabel : button.dataset.resumeLabel)!);
      button.title = button.getAttribute('aria-label')!;
    };
    button.addEventListener('click', () => {
      paused = !paused;
      try { sessionStorage.setItem('nice-campaign-motion', paused ? 'paused' : 'running'); } catch { /* Still works without storage. */ }
      update();
    });
    preference.addEventListener('change', update);
    update();
  }
</script>

<style>
  .campaign-ribbon { margin-block: .75rem 2.5rem; }
  .ribbon-face {
    background: linear-gradient(112deg, #ff782f 0%, #f45a1b 43%, #ef5013 100%);
    box-shadow: 0 16px 36px -20px rgb(172 53 9 / 60%);
    border: 1px solid rgb(255 255 255 / 22%);
  }
  .ribbon-tail {
    position: absolute; z-index: -1; bottom: -.7rem; width: 4.5rem; height: 65%;
    background: #ad350d;
  }
  .ribbon-tail-left { left: -.75rem; clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%, 22% 50%); transform: rotate(-4deg); }
  .ribbon-tail-right { right: -.75rem; clip-path: polygon(0 0, 100% 0, 78% 50%, 100% 100%, 0 100%); transform: rotate(4deg); }
  .campaign-link { grid-template-columns: 9.5rem minmax(0, 1fr); gap: 2rem; min-height: 15rem; padding: 2rem 3.25rem 2rem 2rem; color: #fff; }
  .campaign-logo {
    aspect-ratio: 1; border-radius: 24%; padding: 1.2rem; transform: rotate(-7deg);
    background: #24150f; border: 1px solid rgb(255 255 255 / 24%);
    box-shadow: 8px 10px 0 rgb(123 35 4 / 22%);
  }
  .campaign-logo img { width: 100%; height: auto; transform: rotate(7deg); }
  .campaign-eyebrow { font-size: .75rem; letter-spacing: .18em; line-height: 1.5; color: #180b04; }
  .campaign-title { margin-block-start: .4rem; font-size: clamp(1.65rem, 3vw, 2.25rem); line-height: 1.25; letter-spacing: -.025em; text-wrap: balance; color: #2d1207; }
  .campaign-description { margin-block-start: .65rem; font-size: .9rem; line-height: 1.55; color: #180b04; }
  .campaign-cta { margin-block-start: 1.1rem; min-height: 2.75rem; padding: .65rem 1.1rem; border-radius: .4rem; background: #fff7eb; color: #7e2708; font-size: .875rem; line-height: 1.4; box-shadow: 0 3px 0 rgb(114 33 6 / 20%); }
  .campaign-arrow { flex: none; transition: transform .2s ease; }
  .campaign-link:hover .campaign-arrow { transform: translateX(4px); }
  .campaign-link:hover .campaign-cta { background: #fff; }
  .campaign-link:focus-visible { outline: 3px solid #fff; outline-offset: -6px; border-radius: .75rem; }
  .ribbon-stripe { position: absolute; display: block; width: 13rem; height: 40rem; top: -15rem; background: rgb(255 233 179 / 13%); transform: rotate(32deg); }
  .ribbon-stripe-one { right: 10%; }
  .ribbon-stripe-two { right: -20%; width: 6rem; background: rgb(95 22 0 / 9%); }
  .ribbon-shine { position: absolute; inset: -50%; background: linear-gradient(110deg, transparent 38%, rgb(255 247 230 / 22%) 49%, transparent 60%); transform: translateX(-70%); }
  .ribbon-stripe { animation: ribbon-drift 9s ease-in-out infinite alternate paused; }
  .ribbon-stripe-two { animation-delay: -4s; }
  .ribbon-shine { animation: ribbon-sweep 8s ease-in-out infinite paused; }
  [data-motion='running'] :is(.ribbon-stripe, .ribbon-shine) { animation-play-state: running; }
  .campaign-motion { top: .55rem; right: .55rem; width: 2.5rem; height: 2.5rem; border: 1px solid rgb(255 255 255 / 40%); border-radius: 50%; color: white; background: rgb(77 20 0 / 26%); cursor: pointer; }
  .campaign-motion:hover { background: rgb(77 20 0 / 50%); }
  .campaign-motion:focus-visible { outline: 2px solid white; outline-offset: 2px; }
  .campaign-motion[hidden], [data-motion='running'] .motion-play, [data-motion='paused'] .motion-pause { display: none; }
  @keyframes ribbon-drift { to { transform: translateX(45px) rotate(38deg); } }
  @keyframes ribbon-sweep { 0%, 25% { transform: translateX(-70%); } 75%, 100% { transform: translateX(70%); } }
  @media (max-width: 40rem) {
    .campaign-ribbon { margin-block: .5rem 2rem; }
    .campaign-link { grid-template-columns: 4.5rem minmax(0, 1fr); gap: .85rem; padding: 1.5rem 1.1rem; min-height: 13rem; }
    .campaign-logo { padding: .6rem; box-shadow: 4px 6px 0 rgb(123 35 4 / 22%); align-self: start; margin-block-start: 1.5rem; }
    .campaign-eyebrow { font-size: .65rem; letter-spacing: .12em; padding-right: 1.5rem; }
    .campaign-title { font-size: 1.55rem; }
    .campaign-description { font-size: .8125rem; }
    .campaign-cta { font-size: .8125rem; padding: .65rem .8rem; gap: .5rem; }
    .ribbon-tail { width: 2rem; }
    .ribbon-tail-left { left: -.4rem; }
    .ribbon-tail-right { right: -.4rem; }
  }
  @media (max-width: 24rem) {
    .campaign-link { grid-template-columns: 3.25rem minmax(0, 1fr); gap: .75rem; padding-inline: .9rem; }
    .campaign-logo { padding: .4rem; }
    .campaign-title { font-size: 1.35rem; }
    .campaign-cta { font-size: .75rem; padding-inline: .65rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .campaign-ribbon *, .campaign-ribbon *::before, .campaign-ribbon *::after { animation: none !important; transition: none !important; }
  }
  @media print { .campaign-motion { display: none; } .campaign-ribbon * { animation: none !important; } }
</style>
