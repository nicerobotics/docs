---
const hasToc = Boolean(Astro.locals.starlightRoute.toc);
---

<div class:list={['nice-two-column', { 'has-toc': hasToc }]}>
	{
		hasToc && (
			<aside class="right-sidebar-container print:hidden">
				<div class="right-sidebar">
					<slot name="right-sidebar" />
				</div>
			</aside>
		)
	}
	<div class="main-pane"><slot /></div>
</div>

<style>
	@layer starlight.core {
		.nice-two-column {
			--nice-content-column-width: calc(var(--sl-content-width) + 2 * var(--sl-content-pad-x));
			--nice-toc-width: 14.25rem;
			--nice-toc-gap: clamp(1.5rem, 2vw, 2.5rem);
			min-width: 0;
		}

		.main-pane {
			min-width: 0;
			isolation: isolate;
		}

		@media (min-width: 72rem) {
			.nice-two-column {
				max-width: var(--nice-content-column-width);
				margin-inline: auto;
			}

			.right-sidebar-container {
				display: none;
			}

			.right-sidebar {
				position: sticky;
				top: var(--sl-nav-height);
				width: 100%;
				height: calc(100vh - var(--sl-nav-height));
				overflow-y: auto;
				scrollbar-width: none;
			}

			.main-pane {
				order: 1;
				width: auto;
			}
		}

		@media (min-width: 88rem) {
			.right-sidebar-container {
				display: block;
			}

			.right-sidebar {
				position: fixed;
				inset-block-start: var(--sl-nav-height);
				inset-inline-start: calc(
					(100vw + var(--nice-content-column-width)) / 2 + var(--nice-toc-gap)
				);
				width: var(--nice-toc-width);
				max-height: calc(100vh - var(--sl-nav-height));
			}
		}
	}
</style>
