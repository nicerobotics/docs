---
const hasToc = Boolean(Astro.locals.starlightRoute.toc);
---

<div class:list={['nice-two-column', { 'has-toc': hasToc }]}>
	{
		hasToc && (
			<aside class="right-sidebar-container print:hidden">
				<div class="right-sidebar">
					<slot name="right-sidebar" />
				</div>
			</aside>
		)
	}
	<div class="main-pane"><slot /></div>
</div>

<style>
	@layer starlight.core {
		.nice-two-column {
			--nice-content-column-width: calc(var(--sl-content-width) + 2 * var(--sl-content-pad-x));
			--nice-toc-width: 13.25rem;
			--nice-toc-gap: clamp(1.4rem, 2.5vw, 2.3rem);
			--nice-two-column-width: calc(
				var(--nice-content-column-width) + var(--nice-toc-width) + var(--nice-toc-gap)
			);
			min-width: 0;
		}

		.main-pane {
			min-width: 0;
			isolation: isolate;
		}

		@media (min-width: 72rem) {
			.nice-two-column {
				max-width: var(--nice-content-column-width);
				margin-inline: auto;
			}

			.nice-two-column.has-toc {
				display: grid;
				grid-template-columns: minmax(0, var(--nice-content-column-width)) var(--nice-toc-width);
				align-items: start;
				justify-content: center;
				gap: var(--nice-toc-gap);
				max-width: var(--nice-two-column-width);
			}

			.right-sidebar-container {
				order: 2;
				width: auto;
				min-width: 0;
			}

			.right-sidebar {
				position: sticky;
				top: var(--sl-nav-height);
				width: 100%;
				height: calc(100vh - var(--sl-nav-height));
				overflow-y: auto;
				scrollbar-width: none;
			}

			.main-pane {
				order: 1;
				width: auto;
			}
		}

		@media (min-width: 88rem) {
			.right-sidebar {
				position: fixed;
				inset-block-start: var(--sl-nav-height);
				inset-inline-start: calc(
					var(--sl-content-inline-start, 0rem) +
						((100vw - var(--sl-content-inline-start, 0rem) - var(--nice-two-column-width)) / 2) +
						var(--nice-content-column-width) + var(--nice-toc-gap)
				);
				width: var(--nice-toc-width);
				max-height: calc(100vh - var(--sl-nav-height));
			}
		}
	}
</style>
